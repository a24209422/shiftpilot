# 複製成 .env 再把密碼改成自己的值（.env 不會進 git）
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
# 「自然語言查詢」選單裡的本機模型；OLLAMA_MODEL 是預設選項
LOCAL_MODELS=qwen2.5:3b,qwen3-vl:4b-instruct
# 雲端模型（透過 OpenRouter，到 openrouter.ai 申請 key）。key 留空時選單只會出現本機模型
# 用雲端模型時，問題、資料表結構和資源名稱會送到 OpenRouter，再轉給模型的廠商
OPENROUTER_API_KEY=
OPENROUTER_MODELS=anthropic/claude-haiku-5.5,openai/gpt-6-luna
# Google 的 Gemini API（到 Google AI Studio 建立 key；Google AI Pro 每月附的 Cloud credits 可以拿來付費）
# 不用官方慣用的 GEMINI_API_KEY：Gemini CLI 等工具也讀這個名字，系統層級設了會蓋過這裡
GOOGLE_AI_API_KEY=
GOOGLE_AI_MODELS=gemini-3.5-flash-lite,gemini-3.8-flash

# docker compose 用這兩個密碼建立 PostgreSQL：POSTGRES_PASSWORD 是管理員，APP_DB_PASSWORD 是 app 帳號
# 密碼只用英文和數字：APP_DB_PASSWORD 會直接放進連線網址，@、/、: 這類符號會讓網址解析錯誤
POSTGRES_PASSWORD=change-me-admin
APP_DB_PASSWORD=change-me-app

# 以下給「本機開發」（app 不在容器裡）和測試、評測用；app 容器的連線設定寫在 docker-compose.yml
# app 用非 superuser 的 schedule_app 帳號連線，密碼要跟 APP_DB_PASSWORD 相同
# 主機寫 127.0.0.1 不寫 localhost：Windows 會先試 IPv6 的 ::1，容器只綁 IPv4，每次連線要等逾時才改走 IPv4
DATABASE_URL=postgresql://schedule_app:change-me-app@127.0.0.1:5433/schedule
# 測試與評測用的資料庫，每次執行都建立暫時的 schema，跑完就刪掉
TEST_DATABASE_URL=postgresql://schedule_app:change-me-app@127.0.0.1:5433/schedule_test
